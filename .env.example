LLM_API_KEY=sk-...

# I decided to test end to end if th application is working so for that I used Ollama locally
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=mistral:latest

# OpenAI-compatible chat-completions endpoint. Defaults to OpenAI; point at
# Gemini's compatibility layer to use a Gemini key.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash

# Timeout (seconds) for a single LLM call.
LLM_TIMEOUT_SECONDS=60

# Max retry attempts on transient LLM errors (429/5xx/timeout) before giving up.
LLM_MAX_RETRIES=2

# Base backoff (seconds) between LLM retries; grows exponentially.
LLM_RETRY_BACKOFF_SECONDS=1.0

# Port the MCP knowledge-base server listens on.
PORT=8001

MCP_SERVER_URL=http://localhost:8001

# Timeout (seconds) for a single call to the MCP server.
MCP_TIMEOUT_SECONDS=5

# Max retry attempts on transient MCP errors before giving up.
MCP_MAX_RETRIES=2
